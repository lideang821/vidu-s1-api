# Vidu S API quickstart environment.
# Copy this file to .env and replace the placeholders before running examples.

# API key from https://platform.vidu.cn/api-keys or https://platform.vidu.com/api-keys.
VIDU_API_KEY=vda_your_api_key_here

# Use api.vidu.cn for China, api.vidu.com for overseas.
VIDU_HOST=api.vidu.cn

# Node quickstart server.
NODE_QUICKSTART_PORT=8787

# Avatar defaults for examples/node-quickstart (/avatar).
VIDU_CALL_MODE=video
VIDU_AVATAR_IMAGE_URI=https://scene.vidu.zone/media-asset/083014-Qww8rvO5sOtAKZW8.png
VIDU_AVATAR_PERSONA=You are Sweet Tina. My voice feels like warm milk tea: sweet and cozy, but I am still sharp when solving problems.
VIDU_AVATAR_NAME=Sweet Tina
VIDU_AVATAR_VOICE=Tina

# Editing defaults (/editing). Leave the URL empty to use each scenario's sample image.
VIDU_EDITING_IMAGE_URL=
# style_transfer, virtual_tryon, subject_replacement, background_replacement
VIDU_EDITING_TYPE=style_transfer
